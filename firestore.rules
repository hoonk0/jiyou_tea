rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 상품 — 누구나 볼 수 있고, 로그인한 관리자만 쓸 수 있다
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 공지사항 — 누구나 볼 수 있고, 로그인한 관리자만 쓸 수 있다
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
